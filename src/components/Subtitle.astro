---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Blog" }
});
const { text, class: className } = __props;
---
<span class={cx("mb-(--s-m) text-text text-(length:--s-fs) font-(number:--s-fw) [text-transform:var(--subtitle)] tracking-(--s-ls)", className)}>{text}</span>
