---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Blog" }
});
const { text, class: className } = __props;
---
<span class={style({
    base: {
      fontSize: "var(--s-fs)",
      letterSpacing: "var(--s-ls)",
      fontWeight: "var(--s-fw)",
      color: "var(--text)",
      textTransform: "var(--subtitle)",
      marginBottom: "var(--s-m)"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}>{text}</span>
