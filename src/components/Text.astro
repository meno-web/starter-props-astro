---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Design and publish professional websites without writing code. Start with this template and make it yours in minutes."
  },
  size: {
    type: "select",
    default: "default",
    options: ["small", "default", "medium", "large"]
  },
  color: { type: "select", default: "default", options: ["default", "light"] }
});
const { text, size, color, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={style({
    base: {
      fontSize: {
        _mapping: true,
        prop: "size",
        values: {
          default: "var(--te-fs)",
          small: "var(--tex-fs)",
          medium: "var(--t-fs)",
          large: "var(--text-fs)"
        }
      },
      letterSpacing: "var(--t-ls)",
      fontWeight: "var(--t-fw)",
      lineHeight: "var(--t-lh)",
      color: {
        _mapping: true,
        prop: "color",
        values: { default: "var(--text)", light: "var(--muted)" }
      }
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}><Fragment set:html={text} /></p>
