---
import { cx, resolveProps, richTextWithComponents, variants } from 'meno-astro';
import { cmsComponents } from '../cmsComponents';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Design and publish professional websites without writing code. Start with this template and make it yours in minutes."
  },
  size: {
    type: "select",
    default: "default",
    options: ["small", "default", "medium", "large"]
  },
  color: { type: "select", default: "default", options: ["default", "light"] }
});
const { text, size, color, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={cx(variants(__props, {
    size: {
      default: "text-(length:--te-fs)",
      small: "text-(length:--tex-fs)",
      medium: "text-(length:--t-fs)",
      large: "text-(length:--text-fs)"
    },
    color: { default: "text-(--text)", light: "text-(--muted)" }
  }), "font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)", className)}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></p>
