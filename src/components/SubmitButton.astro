---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Send Message" }
});
const { text, class: className } = __props;
---
<button class={cx("p-(--b-p) mt-(--b-m) inline-flex flex-row justify-center items-center bg-accent text-[var(--white)] border-[none] rounded-(--b-br) text-(length:--te-fs) font-[500] cursor-pointer", className)} type="submit">{text}</button>
