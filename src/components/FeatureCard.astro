---
import { resolveProps, style } from 'meno-astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "This is heading" },
  description: { type: "string", default: "This is heading" }
});
const { text, description, class: className } = __props;
---
<div class={style({
    base: { padding: "24px", backgroundColor: "var(--bg)", borderRadius: "8px" },
    tablet: {},
    mobile: {}
  }, __props, { root: true })}>
  <Heading text={text} tag="3" class={style({ base: { marginBottom: "var(--he-m)" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { marginBottom: "var(--he-m)" }, tablet: {}, mobile: {} }} />
  <Text text={description} />
</div>
