---
import { cx, resolveProps } from 'meno-astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "This is heading" },
  description: { type: "string", default: "This is heading" }
});
const { text, description, class: className } = __props;
---
<div class={cx("p-6 bg-[var(--gray-100)] rounded-[8px]", className)}>
  <Heading text={text} tag="3" class="mb-(--he-m)" />
  <Text text={description} />
</div>
