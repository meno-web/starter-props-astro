---
import { cx, resolveProps, variants } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Button" },
  link: { type: "link", default: { href: "#" } },
  version: {
    type: "select",
    default: "default",
    options: ["default", "secondary"]
  }
});
const { text, link, version, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<Link href={link} class={cx(variants(__props, {
    version: {
      default: "bg-(--accent) text-[var(--white)]",
      secondary: "bg-[var(--gray-200)] text-(--text)"
    }
  }), "p-(--b-p) inline-flex flex-row justify-start items-stretch rounded-(--b-br) text-(length:--te-fs)", className)}>{text}</Link>
