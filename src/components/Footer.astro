---
import { cx, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import FooterLink from './FooterLink.astro';
import FooterLinkTitle from './FooterLinkTitle.astro';
import Text from './Text.astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<footer class={cx(style({}, __props, { label: "Footer" }), "p-(--s-p) bg-bg border-t-[1px_solid_var(--border)]", className)}>
  <div class={style({}, __props, { label: "Container" }) + " m-auto block max-w-(--c-s)"}>
    <div class={style({}, __props, { label: "TopRow" }) + " grid gap-10 grid-cols-[2fr_1fr_1fr_1fr] max-lg:grid-cols-[1fr_1fr] max-sm:grid-cols-[1fr]"}>
      <div class={style({}, __props, { label: "Brand" })}>
        <span class="mb-3 block text-text text-[22px] font-(number:--h-fw) tracking-(--h-ls)">Starter</span>
        <Text text="Short tagline that previews how this footer copy reads in the editor." color="light" class="m-[0] max-w-80" />
      </div>
      <div class={style({}, __props, { label: "Column1" })}>
        <FooterLinkTitle />
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <FooterLink />
          <FooterLink text="Pricing" link="#pricing" />
          <FooterLink text="Integrations" link="#integrations" />
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column2" })}>
        <FooterLinkTitle text="Company" />
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <FooterLink text="About" link="#about" />
          <FooterLink text="Blog" link="/blog" />
          <FooterLink text="Careers" link="#careers" />
        </ul>
      </div>
      <div class={style({}, __props, { label: "Column3" })}>
        <FooterLinkTitle text="Support" />
        <ul class="p-[0] m-[0] flex flex-col gap-2.5 [list-style:none]">
          <FooterLink text="Help Center" link="#help" />
          <FooterLink text="Contact" link="#contact" />
          <FooterLink text="Status" link="#status" />
        </ul>
      </div>
    </div>
    <div class={style({}, __props, { label: "BottomRow" }) + " pt-6 mt-12 flex justify-between items-center border-t-[1px_solid_var(--border)] max-sm:flex-col max-sm:gap-4 max-sm:text-center"}>
      <Text text="© 2026 Starter. All rights reserved." size="small" color="light" />
      <div class="flex gap-6">
        <Link href="#privacy" class={style({}, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
          }) + " text-muted text-[14px] font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Privacy policy</Link>
        <Link href="#terms" class={style({}, __props, {
            interactive: [
              {
                name: "hover",
                prefix: "",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
          }) + " text-muted text-[14px] font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>Terms of Service</Link>
      </div>
    </div>
  </div>
</footer>
