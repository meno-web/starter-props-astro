---
import { cx, resolveProps, richTextWithComponents, variants } from 'meno-astro';
import { cmsComponents } from '../cmsComponents';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Everything you <span class=\"custom-span\" data-meno-span=\"true\">need</span> to build professional website"
  },
  tag: { type: "select", default: "1", options: ["1", "2", "3", "4", "5", "6"] }
});
const { text, tag, class: className } = __props;

const __meno = { acceptsStyles: true };

const Tag_0 = `h${tag}`;
---
<Tag_0 class={cx(variants(__props, {
    tag: {
      "1": "text-(length:--h-fs)",
      "2": "text-(length:--he-fs)",
      "3": "text-(length:--hea-fs)",
      "4": "text-(length:--head-fs)",
      "5": "text-[22px]",
      "6": "text-[20px]",
      default: "text-(length:--h-fs)"
    }
  }), "text-text font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)", className)}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></Tag_0>
