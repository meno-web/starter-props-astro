---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Badge" }
});
const { text, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<span class={cx("p-[4px_12px] inline-block bg-[var(--gray-100)] text-text rounded-[999px] text-(length:--tex-fs) font-[500]", className)}>{text}</span>
