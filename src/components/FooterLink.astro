---
import { cx, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Features" },
  link: { type: "link", default: { href: "#features" } }
});
const { text, link, class: className } = __props;
---
<li class={cx(className)}>
  <Link href={link} class={style({}, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { color: "var(--text)" } }
        }
      ]
    }) + " text-muted text-(length:--t-fs) font-(number:--t-fw) no-underline tracking-(--t-ls) transition-[color_0.2s]"}>{text}</Link>
</li>
