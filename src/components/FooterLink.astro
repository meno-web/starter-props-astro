---
import { resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Features" },
  link: { type: "link", default: { href: "#features" } }
});
const { text, link, class: className } = __props;
---
<li class={style({}, __props, { root: true })}>
  <Link href={link} class={style({
      base: {
        color: "var(--muted)",
        fontSize: "var(--t-fs)",
        letterSpacing: "var(--t-ls)",
        fontWeight: "var(--t-fw)",
        textDecoration: "none",
        transition: "color 0.2s"
      }
    }, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { color: "var(--text)" } }
        }
      ]
    })}>{text}</Link>
</li>
