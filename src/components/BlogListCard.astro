---
import { cx, resolveProps } from 'meno-astro';
import { Link, MenoImage } from 'meno-astro/components';
import Badge from './Badge.astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
const { post } = Astro.props;
---
<Link href={post._url} class={cx("flex flex-col justify-start items-stretch bg-bg text-text border-[1px_solid_var(--border)] rounded-[8px] no-underline overflow-hidden", className)}>
  <MenoImage src={post.image || undefined} alt={post.title || undefined} class="aspect-[16_/_10] object-cover" />
  <div class="p-6 flex flex-col items-start gap-3">
    <Badge text={post.category} />
    <Heading text={post.title} tag="4" class="m-[0]" />
    <Text text={post.date} color="light" class="text-(length:--te-fs)" />
    <Text text={post.description} class="mt-1" />
  </div>
</Link>
