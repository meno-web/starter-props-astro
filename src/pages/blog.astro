---
import { getCollection } from 'astro:content';
import { getCollectionList, i18n } from 'meno-astro';
import { BaseLayout } from 'meno-astro/components';
import BlogListCard from '../components/BlogListCard.astro';
import Heading from '../components/Heading.astro';
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Subtitle from '../components/Subtitle.astro';
import Text from '../components/Text.astro';
import '../styles/theme.css';

const meta = { title: "Blog", description: "Browse all articles, tutorials, and insights." };

const blogList = await getCollectionList("blog", { sort: { field: "_createdAt", order: "desc" } }, Astro, getCollection);
---
<BaseLayout meta={meta}>
  <Layout>
    <Section>
      <div class="mb-[52px] flex flex-col justify-start items-center text-center">
        <Subtitle text="Blog" />
        <Heading text="All articles" class="mb-(--h-m) text-center" />
        <Text text="Browse every post, tutorial, and insight we've published." class="max-w-[520px] text-center" />
      </div>
      <div class="grid gap-4 grid-cols-[1fr_1fr_1fr]">
        {blogList.map((post, postIndex) => (
          <BlogListCard post={i18n(post)} />
        ))}
      </div>
    </Section>
  </Layout>
</BaseLayout>
