---
import { getCollection } from 'astro:content';
import { getCollectionList, style } from 'meno-astro';
import { BaseLayout } from 'meno-astro/components';
import BlogListCard from '../components/BlogListCard.astro';
import Button from '../components/Button.astro';
import FaqQuestion from '../components/FaqQuestion.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Heading from '../components/Heading.astro';
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Subtitle from '../components/Subtitle.astro';
import Text from '../components/Text.astro';
import '../styles/theme.css';

const meta = { title: "starter-variables-01", description: "Created with Meno Studio" };

const blogList = await getCollectionList("blog", { sort: { field: "_createdAt", order: "desc" }, limit: 3 }, Astro, getCollection);
---
<BaseLayout meta={meta}>
  <Layout>
    <Section>
      <div class={style({
          base: {
            display: "flex",
            flexDirection: "column",
            justifyContent: "flex-start",
            alignItems: "center",
            margin: "auto"
          },
          tablet: {},
          mobile: {}
        })}>
        <Heading text={`<!--MENO_RAW_HTML-->Everything you <span class="custom-span">need</span> to build professional website`} tag="1" class={style({
            base: { marginBottom: "var(--h-m)", textAlign: "center", maxWidth: "725px" },
            tablet: {},
            mobile: {}
          }, undefined, { instance: true })} __menoStyle={{
            base: { marginBottom: "var(--h-m)", textAlign: "center", maxWidth: "725px" },
            tablet: {},
            mobile: {}
          }} />
        <Text text="Design and publish professional websites without writing code. Start with this template and make it yours in minutes." size="default" class={style({ base: { textAlign: "center", maxWidth: "500px" } }, undefined, { instance: true })} __menoStyle={{ base: { textAlign: "center", maxWidth: "500px" } }} />
        <div class={style({
            base: {
              display: "flex",
              flexDirection: "row",
              justifyContent: "flex-start",
              alignItems: "stretch",
              gap: "12px",
              marginTop: "var(--b-m)"
            },
            tablet: {},
            mobile: {}
          })}>
          <Button version="default" />
          <Button text="Button" link="#" version="secondary" />
        </div>
      </div>
    </Section>
    <Section class={style({ base: { backgroundColor: "var(--gray-100)" } }, undefined, { instance: true })} __menoStyle={{ base: { backgroundColor: "var(--gray-100)" } }}>
      <Heading text={`<!--MENO_RAW_HTML-->This is <span class="custom-span">features</span> headline`} tag="2" class={style({ base: { marginBottom: "var(--h-m)" }, tablet: {}, mobile: {} }, undefined, { instance: true })} __menoStyle={{ base: { marginBottom: "var(--h-m)" }, tablet: {}, mobile: {} }} />
      <Text text="Short supporting description that previews how this section looks and reads in the editor" class={style({ base: { maxWidth: "380px" } }, undefined, { instance: true })} __menoStyle={{ base: { maxWidth: "380px" } }} />
      <div class={style({
          base: {
            display: "grid",
            gridTemplateColumns: "1fr 1fr 1fr",
            gap: "16px",
            marginTop: "40px"
          },
          tablet: {},
          mobile: {}
        })}>
        <FeatureCard description="This is description" text="Feature 1" />
        <FeatureCard description="This is description" text="Feature 2" />
        <FeatureCard description="This is description" text="Feature 3" />
      </div>
    </Section>
    <Section>
      <div class={style({ base: { maxWidth: "var(--co-s)", margin: "auto" }, tablet: {}, mobile: {} })}>
        <Heading text="Frequently asked questions" tag="2" class={style({ base: { marginBottom: "var(--h-m)" }, tablet: {}, mobile: {} }, undefined, { instance: true })} __menoStyle={{ base: { marginBottom: "var(--h-m)" }, tablet: {}, mobile: {} }} />
        <Text text="Short supporting description that previews how this section looks and reads in the editor." />
        <div class={style({
            base: {
              marginTop: "60px",
              display: "flex",
              flexDirection: "column",
              justifyContent: "space-between",
              alignItems: "stretch"
            },
            tablet: {},
            mobile: {}
          })}>
          <FaqQuestion answer="Short supporting description that previews how this section looks and reads in the editor" question="First question" isOpen={false} />
          <FaqQuestion question="Second question" answer="Short supporting description that previews how this section looks and reads in the editor" />
          <FaqQuestion question="Third question" answer="Short supporting description that previews how this section looks and reads in the editor" />
          <FaqQuestion question="Fourth question" answer="Short supporting description that previews how this section looks and reads in the editor" isOpen={false} />
        </div>
      </div>
    </Section>
    <Section>
      <div class={style({
          base: {
            display: "flex",
            flexDirection: "column",
            justifyContent: "flex-start",
            alignItems: "center",
            textAlign: "center",
            marginBottom: "52px"
          },
          tablet: {},
          mobile: {}
        })}>
        <Subtitle text="Blog" />
        <Heading text="Latest articles" class={style({ base: { marginBottom: "var(--h-m)", textAlign: "center" } }, undefined, { instance: true })} __menoStyle={{ base: { marginBottom: "var(--h-m)", textAlign: "center" } }} />
        <Text text="Stay up to date with the latest news, tips, and insights." class={style({ base: { textAlign: "center", maxWidth: "520px" } }, undefined, { instance: true })} __menoStyle={{ base: { textAlign: "center", maxWidth: "520px" } }} />
      </div>
      <div class={style({
          base: { display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "16px" },
          tablet: {},
          mobile: {}
        })}>
        {blogList.map((post, postIndex) => (
          <BlogListCard post={post} />
        ))}
      </div>
    </Section>
  </Layout>
</BaseLayout>
