{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "children": [
          {
            "type": "node",
            "tag": "div",
            "style": {
              "base": {
                "maxWidth": "var(--co-s)",
                "margin": "auto"
              },
              "tablet": {},
              "mobile": {}
            },
            "children": [
              {
                "type": "component",
                "component": "Badge",
                "props": {
                  "text": "{{cms.category}}"
                },
                "style": {
                  "base": {
                    "fontSize": "14px",
                    "marginBottom": "16px"
                  }
                }
              },
              {
                "type": "component",
                "component": "Heading",
                "props": {
                  "text": "{{cms.title}}"
                },
                "style": {
                  "base": {
                    "marginBottom": "var(--h-m)"
                  }
                }
              },
              {
                "type": "component",
                "component": "Text",
                "props": {
                  "text": "{{cms.date}}",
                  "color": "light"
                },
                "style": {
                  "base": {},
                  "tablet": {},
                  "mobile": {}
                }
              },
              {
                "type": "node",
                "tag": "img",
                "style": {
                  "base": {
                    "width": "100%",
                    "aspectRatio": "16 / 9",
                    "objectFit": "cover",
                    "borderRadius": "8px",
                    "marginTop": "32px",
                    "marginBottom": "32px"
                  },
                  "tablet": {},
                  "mobile": {}
                },
                "attributes": {
                  "src": "{{cms.image}}",
                  "alt": "{{cms.title}}"
                }
              },
              {
                "type": "component",
                "component": "RichText",
                "props": {
                  "content": "{{cms.content}}"
                },
                "style": {
                  "base": {
                    "marginTop": "24px",
                    "maxWidth": "621px",
                    "margin": "auto"
                  },
                  "tablet": {},
                  "mobile": {}
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": "{{cms.title}}",
    "description": "{{cms.description}}",
    "source": "cms",
    "cms": {
      "id": "blog",
      "name": "Blog",
      "slugField": "slug",
      "urlPattern": "/blog/{{slug}}",
      "fields": {
        "title": {
          "type": "string",
          "label": "Title",
          "required": true
        },
        "slug": {
          "type": "string",
          "label": "URL Slug",
          "required": true
        },
        "category": {
          "type": "string",
          "label": "Category"
        },
        "date": {
          "type": "string",
          "label": "Date"
        },
        "description": {
          "type": "text",
          "label": "Description"
        },
        "image": {
          "type": "image",
          "label": "Cover image"
        },
        "content": {
          "type": "rich-text",
          "label": "Content"
        }
      }
    }
  }
}