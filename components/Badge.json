{
  "component": {
    "structure": {
      "type": "node",
      "tag": "span",
      "style": {
        "base": {
          "display": "inline-block",
          "padding": "4px 12px",
          "backgroundColor": "var(--gray-100)",
          "borderRadius": "999px",
          "fontSize": "var(--tex-fs)",
          "fontWeight": "500",
          "color": "var(--text)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": "{{text}}"
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Badge"
      }
    },
    "acceptsStyles": true
  }
}