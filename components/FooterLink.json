{
  "component": {
    "interface": {
      "text": {
        "type": "string",
        "default": "Features"
      },
      "link": {
        "type": "link",
        "default": {
          "href": "#features"
        }
      }
    },
    "structure": {
      "type": "node",
      "tag": "li",
      "children": [
        {
          "type": "link",
          "href": "{{link}}",
          "style": {
            "base": {
              "color": "var(--muted)",
              "fontSize": "var(--t-fs)",
              "letterSpacing": "var(--t-ls)",
              "fontWeight": "var(--t-fw)",
              "textDecoration": "none",
              "transition": "color 0.2s"
            }
          },
          "interactiveStyles": [
            {
              "name": "hover",
              "prefix": "",
              "postfix": ":hover",
              "style": {
                "base": {
                  "color": "var(--text)"
                }
              }
            }
          ],
          "children": [
            "{{text}}"
          ]
        }
      ]
    }
  }
}