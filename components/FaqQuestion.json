{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "width": "100%",
          "borderBottom": "1px solid var(--border, #e0e0e0)"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "data-faq-item": "true"
      },
      "children": [
        {
          "type": "node",
          "tag": "button",
          "style": {
            "base": {
              "width": "100%",
              "padding": "20px 0",
              "background": "transparent",
              "border": "none",
              "cursor": "pointer",
              "display": "flex",
              "justifyContent": "space-between",
              "alignItems": "center",
              "gap": "16px"
            },
            "tablet": {},
            "mobile": {}
          },
          "attributes": {
            "data-faq-toggle": "true",
            "type": "button"
          },
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{question}}",
                "tag": "3"
              },
              "style": {
                "base": {},
                "tablet": {},
                "mobile": {}
              }
            },
            {
              "type": "node",
              "tag": "span",
              "style": {
                "base": {
                  "fontSize": "20px",
                  "transition": "transform 0.3s ease",
                  "display": "flex",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "color": "var(--text)",
                  "flexShrink": 0
                },
                "tablet": {},
                "mobile": {}
              },
              "interactiveStyles": [
                {
                  "name": "when open",
                  "prefix": "[data-faq-item].is-open ",
                  "postfix": "",
                  "style": {
                    "base": {
                      "transform": "rotate(45deg)"
                    }
                  },
                  "previewProp": "isOpen"
                }
              ],
              "attributes": {
                "data-faq-icon": "true"
              },
              "children": [
                "+"
              ]
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "maxHeight": "0",
              "overflow": "hidden",
              "transition": "max-height 0.3s ease, padding 0.3s ease",
              "paddingBottom": "0"
            },
            "tablet": {},
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "when open",
              "prefix": "[data-faq-item].is-open ",
              "postfix": "",
              "style": {
                "base": {
                  "maxHeight": "1000px",
                  "paddingBottom": "20px"
                }
              },
              "previewProp": "isOpen"
            }
          ],
          "attributes": {
            "data-faq-answer": "true"
          },
          "children": [
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{answer}}",
                "size": "medium"
              },
              "style": {
                "base": {
                  "maxWidth": "530px",
                  "margin": "0 0 20px 0"
                }
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "question": {
        "type": "string",
        "default": "First question"
      },
      "answer": {
        "type": "string",
        "default": "Short supporting description that previews how this section looks and reads in the editor"
      },
      "isOpen": {
        "type": "boolean",
        "default": false
      }
    },
    "defineVars": true
  }
}